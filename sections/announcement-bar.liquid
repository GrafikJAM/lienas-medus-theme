{%- if section.settings.text != blank -%}
  <div class="announcement scheme-{{ section.settings.scheme }}">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "BEZMAKSAS PIEGĀDE PASŪTĪJUMIEM VIRS €40" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select", "id": "scheme", "label": "Colour", "default": "honey",
      "options": [
        { "value": "honey", "label": "Honey" }, { "value": "dark", "label": "Dark" },
        { "value": "light", "label": "Light" }, { "value": "green", "label": "Green" },
        { "value": "lime", "label": "Lime" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
