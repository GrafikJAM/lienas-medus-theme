<section class="category-tiles">
  {%- if section.settings.heading != blank -%}
    <div class="page-width section--tight"><h2>{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="tiles" style="--cols: {{ section.blocks.size | at_most: 4 }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign img = block.settings.image | default: c.featured_image
      -%}
      <a class="tile scheme-{{ block.settings.scheme }}" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
        <div>
          {%- if block.settings.sticker != blank -%}<span class="sticker sticker--light" style="--tilt:-5deg">{{ block.settings.sticker }}</span>{%- endif -%}
          <h3 class="tile__title">{{ block.settings.title | default: c.title }}</h3>
        </div>
        {%- if img -%}
          <div class="tile__image">{{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}</div>
        {%- endif -%}
        <span class="tile__cta label">{{ block.settings.cta }} <span class="arrow-circle">{% render 'icon', name: 'arrow' %}</span></span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title (optional)" },
        { "type": "text", "id": "sticker", "label": "Sticker" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Cut-out jar PNG works best." },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Skatīt" },
        {"type": "select", "id": "scheme", "label": "Colour block", "default": "honey", "options": [{"value": "light", "label": "LM Light"}, {"value": "honey", "label": "LM Honey"}, {"value": "dark", "label": "LM Dark"}, {"value": "propolis", "label": "LM Propolis"}, {"value": "green", "label": "Green"}, {"value": "lime", "label": "Lime"}, {"value": "lavender", "label": "Lavender"}, {"value": "sky", "label": "Sky"}]}
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Medus", "sticker": "300 / 500 g", "scheme": "honey" } },
        { "type": "tile", "settings": { "title": "Maisījumi", "sticker": "13 garšas", "scheme": "green" } },
        { "type": "tile", "settings": { "title": "Komplekti", "sticker": "Dāvanām", "scheme": "propolis" } }
      ]
    }
  ]
}
{% endschema %}
