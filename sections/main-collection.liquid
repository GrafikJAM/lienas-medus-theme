{%- liquid
  assign s = section.settings
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}
<section class="collection-hero section--tight scheme-{{ s.scheme }}">
  <div class="page-width">
    <div class="collection-hero__inner">
      <div>
        <p class="eyebrow">{{ 'collections.products_count' | t: count: collection.products_count }}</p>
        <h1 class="display">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}<div class="lead rte">{{ collection.description }}</div>{%- endif -%}
      </div>
      {%- if s.menu != blank -%}
        <nav class="chips" aria-label="{{ s.menu.title | escape }}">
          {%- for link in s.menu.links -%}
            <a class="chip" href="{{ link.url }}"{% if link.url == collection.url %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="page-width">
  {%- paginate collection.products by s.per_page -%}
    <div class="toolbar">
      <span class="label">{{ 'collections.products_count' | t: count: collection.products_count }}</span>
      <form method="get" action="{{ collection.url }}">
        <label class="visually-hidden" for="SortBy">{{ 'collections.sort_by' | t }}</label>
        <select id="SortBy" name="sort_by" class="select" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="product-grid" style="--cols: {{ s.columns }}">
        {%- for product in collection.products -%}
          {%- liquid
            assign loading = 'lazy'
            if forloop.index <= 4
              assign loading = 'eager'
            endif
          -%}
          {% render 'product-card', product: product, quick_add: s.quick_add, loading: loading %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty-state h3">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="current" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
  <div style="height: clamp(40px, 6vw, 80px)"></div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {"type": "select", "id": "scheme", "label": "Colour block", "default": "honey", "options": [{"value": "light", "label": "LM Light"}, {"value": "honey", "label": "LM Honey"}, {"value": "dark", "label": "LM Dark"}, {"value": "propolis", "label": "LM Propolis"}, {"value": "green", "label": "Green"}, {"value": "lime", "label": "Lime"}, {"value": "lavender", "label": "Lavender"}, {"value": "sky", "label": "Sky"}]},
    { "type": "link_list", "id": "menu", "label": "Category chips menu", "info": "E.g. a menu with Medus / Maisījumi / Komplekti / Pārtika" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "quick_add", "label": "Show size picker + add to cart", "default": true }
  ]
}
{% endschema %}
