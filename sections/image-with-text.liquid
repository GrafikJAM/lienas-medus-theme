{%- assign s = section.settings -%}
<section class="split{% if s.reverse %} split--reverse{% endif %} scheme-{{ s.scheme }}">
  <div class="split__media">
    {%- if s.image -%}
      {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '(min-width: 850px) 50vw, 100vw', alt: s.image.alt }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if s.show_stamp and settings.badge_image -%}
      <div class="stamp">{{ settings.badge_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}</div>
    {%- endif -%}
  </div>
  <div class="split__content reveal">
    {%- if s.big_number != blank -%}<div class="split__year">{{ s.big_number }}</div>{%- endif -%}
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h2>{{ s.heading }}</h2>
    <div class="rte lead">{{ s.text }}</div>
    {%- if s.button_label != blank -%}
      <p style="margin-top:1.5rem"><a class="button" href="{{ s.button_link }}">{{ s.button_label }} {% render 'icon', name: 'arrow' %}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {"type": "select", "id": "scheme", "label": "Colour block", "default": "dark", "options": [{"value": "light", "label": "LM Light"}, {"value": "honey", "label": "LM Honey"}, {"value": "dark", "label": "LM Dark"}, {"value": "propolis", "label": "LM Propolis"}, {"value": "green", "label": "Green"}, {"value": "lime", "label": "Lime"}, {"value": "lavender", "label": "Lavender"}, {"value": "sky", "label": "Sky"}]},
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "text", "id": "big_number", "label": "Big number / year", "default": "2006" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mūsu stāsts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Viss sākās liepas dobumā." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>2006. gada vasarā pie mums atlidoja pirmā bišu saime un iemājoja liepas dobumā. Tā sākās mūsu bioloģiskā saimniekošana – pie upes, meža un pļavas.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Par mums" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_stamp", "label": "Show rotating brand badge", "default": false }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
