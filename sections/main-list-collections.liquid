<section class="collection-hero section--tight scheme-{{ section.settings.scheme }}">
  <div class="page-width"><h1 class="display">{{ section.settings.heading }}</h1></div>
</section>
<div class="tiles" style="--cols: 3">
  {%- for c in collections -%}
    {%- unless c.handle == 'frontpage' -%}
      <a class="tile {% cycle 'scheme-honey', 'scheme-green', 'scheme-propolis', 'scheme-dark', 'scheme-lime', 'scheme-lavender' %}" href="{{ c.url }}">
        <h2 class="tile__title">{{ c.title }}</h2>
        {%- if c.featured_image -%}<div class="tile__image">{{ c.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '' }}</div>{%- endif -%}
        <span class="tile__cta label">{{ 'collections.products_count' | t: count: c.products_count }} <span class="arrow-circle">{% render 'icon', name: 'arrow' %}</span></span>
      </a>
    {%- endunless -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {"type": "select", "id": "scheme", "label": "Colour block", "default": "light", "options": [{"value": "light", "label": "LM Light"}, {"value": "honey", "label": "LM Honey"}, {"value": "dark", "label": "LM Dark"}, {"value": "propolis", "label": "LM Propolis"}, {"value": "green", "label": "Green"}, {"value": "lime", "label": "Lime"}, {"value": "lavender", "label": "Lavender"}, {"value": "sky", "label": "Sky"}]},
    { "type": "text", "id": "heading", "label": "Heading", "default": "Veikals" }
  ]
}
{% endschema %}
