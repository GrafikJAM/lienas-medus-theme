<section class="collection-hero section--tight scheme-{{ section.settings.scheme }}">
  <div class="page-width"><h1 class="display">{{ blog.title }}</h1></div>
</section>
<section class="section">
  <div class="page-width">
    {%- paginate blog.articles by 9 -%}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          <a class="article-card reveal" href="{{ article.url }}">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 850px) 33vw, 100vw', alt: article.image.alt }}
            {%- endif -%}
            <span class="label">{{ article.published_at | date: format: 'date' }}</span>
            <h3>{{ article.title }}</h3>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [ {"type": "select", "id": "scheme", "label": "Colour block", "default": "lime", "options": [{"value": "light", "label": "LM Light"}, {"value": "honey", "label": "LM Honey"}, {"value": "dark", "label": "LM Dark"}, {"value": "propolis", "label": "LM Propolis"}, {"value": "green", "label": "Green"}, {"value": "lime", "label": "Lime"}, {"value": "lavender", "label": "Lavender"}, {"value": "sky", "label": "Sky"}]} ] }
{% endschema %}
