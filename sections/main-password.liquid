<section class="section scheme-honey" style="min-height: 100vh; display:grid; place-items:center">
  <div class="page-width text-center">
    <p class="display">{{ shop.name }}</p>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'newsletter-form' -%}
      <label class="visually-hidden" for="Password">{{ 'password.password' | t }}</label>
      <input id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
      <button class="button" type="submit">{{ 'password.submit' | t }}</button>
      {%- if form.errors -%}<p class="form-message" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password" }
{% endschema %}
