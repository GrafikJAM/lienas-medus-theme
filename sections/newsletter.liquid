<section class="section scheme-{{ section.settings.scheme }}">
  <div class="page-width text-center reveal">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
      <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
      <button type="submit" class="button">{{ 'newsletter.subscribe' | t }}</button>
      {%- if form.posted_successfully? -%}<p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {"type": "select", "id": "scheme", "label": "Colour block", "default": "honey", "options": [{"value": "light", "label": "LM Light"}, {"value": "honey", "label": "LM Honey"}, {"value": "dark", "label": "LM Dark"}, {"value": "propolis", "label": "LM Propolis"}, {"value": "green", "label": "Green"}, {"value": "lime", "label": "Lime"}, {"value": "lavender", "label": "Lavender"}, {"value": "sky", "label": "Sky"}]},
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bzzz… jaunumi e-pastā" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Sezonālie piedāvājumi, receptes un ielūgumi uz saimniecību. Ne biežāk kā reizi mēnesī.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
