{%- assign s = section.settings -%}
<section class="section scheme-{{ s.scheme }}">
  <div class="page-width banner">
    <div class="reveal">
      {%- if s.sticker != blank -%}<span class="sticker sticker--{{ s.sticker_color }}" style="--tilt:-5deg; margin-bottom: 1.5rem">{{ s.sticker }}</span>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      <div class="rte lead">{{ s.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <ul class="banner__list">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="button" href="{{ s.button_link }}">{{ s.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="banner__media">
      {%- if s.image -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 850px) 45vw, 100vw', alt: s.image.alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner",
  "settings": [
    {"type": "select", "id": "scheme", "label": "Colour block", "default": "green", "options": [{"value": "light", "label": "LM Light"}, {"value": "honey", "label": "LM Honey"}, {"value": "dark", "label": "LM Dark"}, {"value": "propolis", "label": "LM Propolis"}, {"value": "green", "label": "Green"}, {"value": "lime", "label": "Lime"}, {"value": "lavender", "label": "Lavender"}, {"value": "sky", "label": "Sky"}]},
    { "type": "text", "id": "sticker", "label": "Sticker", "default": "Sezonāli" },
    { "type": "select", "id": "sticker_color", "label": "Sticker colour", "default": "honey", "options": [
      { "value": "honey", "label": "Honey" }, { "value": "lime", "label": "Lime" }, { "value": "light", "label": "Light" },
      { "value": "dark", "label": "Dark" }, { "value": "lavender", "label": "Lavender" }, { "value": "sky", "label": "Sky" } ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sezonālās pārtikas kaste" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Svaigi dārzeņi, zaļumi un medus no mūsu saimniecības – katru nedēļu līdz Tavām durvīm.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Pasūtīt kasti" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "point", "name": "Bullet point", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Bezmaksas piegāde ceturtdienās" } ] }
  ],
  "presets": [
    {
      "name": "Banner",
      "blocks": [
        { "type": "point", "settings": { "text": "Mazā kaste – €30, lielā – €50" } },
        { "type": "point", "settings": { "text": "Bezmaksas piegāde katru ceturtdienu 8:00–16:00" } },
        { "type": "point", "settings": { "text": "Tikai tas, kas šonedēļ izaudzis" } }
      ]
    }
  ]
}
{% endschema %}
