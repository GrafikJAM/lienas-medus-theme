{%- liquid
  assign s = section.settings
  assign layout_class = 'hero--split'
  if s.layout == 'full'
    assign layout_class = 'hero--full'
  endif
  if s.video != blank and s.video_style == 'card'
    assign layout_class = layout_class | append: ' hero--card'
  endif
-%}
<section class="hero {{ layout_class }} scheme-{{ s.scheme }}" style="--overlay: {{ s.overlay | divided_by: 100.0 }}">
  <div class="page-width">
    <div class="hero__grid">
      <div class="hero__content">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h1 class="display">{{ s.heading }}</h1>
        {%- if s.text != blank -%}<div class="lead">{{ s.text }}</div>{%- endif -%}
        <div class="hero__actions">
          {%- if s.button_label != blank -%}
            <a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }} {% render 'icon', name: 'arrow' %}</a>
          {%- endif -%}
          {%- if s.button2_label != blank -%}
            <a class="button button--outline" href="{{ s.button2_link }}">{{ s.button2_label }}</a>
          {%- endif -%}
        </div>
      </div>
      <div class="hero__media{% if s.contain %} hero__media--contain{% endif %}">
        {%- if s.video != blank -%}
          <div class="hero__video-wrap" style="--ar: {{ s.video.aspect_ratio | default: 1.7778 }}; --card-tilt: {{ s.card_tilt }}deg">
            {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x', class: 'hero__video' }}
          </div>
        {%- elsif s.image -%}
          {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '(min-width: 900px) 50vw, 100vw', alt: s.image.alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        <div class="hero__stickers">
          {%- for block in section.blocks -%}
            <span class="sticker sticker--{{ block.settings.color }}" style="top: {{ block.settings.top }}%; left: {{ block.settings.left }}%; --tilt: {{ block.settings.tilt }}deg" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  {%- if s.show_stamp -%}{% render 'brand-stamp' %}{%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [ { "value": "split", "label": "Text + media (50/50)" }, { "value": "full", "label": "Full-width media" } ] },
    {"type": "select", "id": "scheme", "label": "Colour block", "default": "honey", "options": [{"value": "light", "label": "LM Light"}, {"value": "honey", "label": "LM Honey"}, {"value": "dark", "label": "LM Dark"}, {"value": "propolis", "label": "LM Propolis"}, {"value": "green", "label": "Green"}, {"value": "lime", "label": "Lime"}, {"value": "lavender", "label": "Lavender"}, {"value": "sky", "label": "Sky"}]},
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ģimenes saimniecība kopš 2006" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Medus, kas garšo pēc pļavas." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bioloģisks medus un medus maisījumi no mūsu bitēm, upes un meža.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Iepirkties" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Mūsu stāsts" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "header", "content": "Video" },
    { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on loop. Pick it from Content → Files. Shown instead of the image." },
    { "type": "select", "id": "video_style", "label": "Video style", "default": "card", "options": [ { "value": "card", "label": "Floating thumbnail" }, { "value": "fill", "label": "Fill the area edge to edge" } ] },
    { "type": "range", "id": "card_tilt", "label": "Thumbnail tilt", "min": -6, "max": 6, "step": 1, "unit": "°", "default": -2 },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "contain", "label": "Fit media instead of cropping (for cut-out jar shots)", "default": false },
    { "type": "range", "id": "overlay", "label": "Dark overlay (full-width layout)", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "checkbox", "id": "show_stamp", "label": "Show rotating brand badge", "default": true }
  ],
  "blocks": [
    {
      "type": "sticker",
      "name": "Sticker",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Medus" },
        { "type": "select", "id": "color", "label": "Colour", "default": "honey", "options": [
          { "value": "honey", "label": "Honey" }, { "value": "green", "label": "Green" }, { "value": "dark", "label": "Dark" },
          { "value": "lime", "label": "Lime" }, { "value": "lavender", "label": "Lavender" }, { "value": "sky", "label": "Sky" },
          { "value": "propolis", "label": "Propolis" }, { "value": "light", "label": "Light" } ] },
        { "type": "range", "id": "top", "label": "Position from top", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 12 },
        { "type": "range", "id": "left", "label": "Position from left", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 8 },
        { "type": "range", "id": "tilt", "label": "Tilt", "min": -20, "max": 20, "step": 1, "unit": "°", "default": -6 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "sticker", "settings": { "text": "Bioloģisks", "color": "dark", "top": 10, "left": 6, "tilt": -8 } },
        { "type": "sticker", "settings": { "text": "Medus", "color": "honey", "top": 72, "left": 58, "tilt": 6 } },
        { "type": "sticker", "settings": { "text": "Uzturs", "color": "green", "top": 80, "left": 14, "tilt": -4 } }
      ]
    }
  ]
}
{% endschema %}
