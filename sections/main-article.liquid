<article class="section">
  <div class="page-width article">
    <p class="label"><a href="{{ blog.url }}">← {{ 'blog.back' | t }}</a> · {{ article.published_at | date: format: 'date' }}</p>
    <h1>{{ article.title }}</h1>
    {%- if article.image -%}
      {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 800px) 760px, 100vw', alt: article.image.alt, style: 'border: var(--rule); margin: 2rem 0' }}
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
