{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign tint = product.metafields.custom.label_color.value
-%}
<section class="product" data-product data-update-url{% if tint != blank %} style="--card-tint: {{ tint }}"{% endif %}>
  <div class="product__media">
    <div class="product__gallery">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          {%- if forloop.first -%}
            {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 55vw, 100vw', alt: media.alt | default: product.title }}
          {%- else -%}
            {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 55vw, 100vw', alt: media.alt | default: product.title }}
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endfor -%}
    </div>
  </div>

  <div class="product__info">
    <div class="product__info-inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'stickers' -%}
            <div class="product__badges" {{ block.shopify_attributes }}>
              {% render 'product-stickers', product: product %}
              {%- assign t = product.tags | join: ',' | downcase -%}
              {%- if t contains 'medus' -%}<span class="sticker" style="--tilt:-4deg">Medus</span>{%- endif -%}
              {%- if t contains 'mix' -%}<span class="sticker sticker--green" style="--tilt:3deg">Maisījums</span>{%- endif -%}
            </div>
          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
          {%- when 'price' -%}
            <div class="product__price" {{ block.shopify_attributes }}>
              {% render 'price', product: product %}
              {%- if cart.taxes_included -%}<small>{{ 'products.product.tax_included' | t }}</small>{%- endif -%}
            </div>
          {%- when 'description' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {%- when 'buy' -%}
            {%- form 'product', product, class: 'product__form', data-ajax-cart: '' -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
              {%- unless product.has_only_default_variant -%}
                <div data-variant-picker>
                  {%- for option in product.options_with_values -%}
                    <fieldset>
                      <legend class="label">{{ option.name }}</legend>
                      <div class="card__sizes">
                        {%- for value in option.values -%}
                          <label class="size-pill">
                            <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                            <span>{{ value }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}
              <div class="product__buy">
                <div class="qty">
                  <button type="button" data-qty-step="-1" aria-label="{{ 'accessibility.decrease' | t }}">−</button>
                  <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'accessibility.quantity' | t }}">
                  <button type="button" data-qty-step="1" aria-label="{{ 'accessibility.increase' | t }}">+</button>
                </div>
                <button type="submit" class="button button--honey" {% unless variant.available %}disabled{% endunless %}>
                  {%- if variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                  {% render 'icon', name: 'arrow' %}
                </button>
              </div>
              {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
            {%- endform -%}
            <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
          {%- when 'collapsible' -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <details>
                <summary>{{ block.settings.heading }}</summary>
                <div class="rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
              </details>
            </div>
          {%- when 'text' -%}
            <p class="{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_media -%}"image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
  "description": {{ product.description | strip_html | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": [
    {%- for v in product.variants -%}
    {
      "@type": "Offer",
      "name": {{ v.title | json }},
      "availability": "http://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ v.price | divided_by: 100.00 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "url": {{ request.origin | append: v.url | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Product",
  "blocks": [
    { "type": "@app" },
    { "type": "stickers", "name": "Stickers", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "buy", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": false } ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Bezmaksas piegāde ceturtdienās" },
      { "type": "select", "id": "style", "label": "Style", "default": "label", "options": [ { "value": "label", "label": "Label" }, { "value": "lead", "label": "Large" }, { "value": "", "label": "Body" } ] } ] },
    { "type": "collapsible", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Lietošana" },
      { "type": "richtext", "id": "content", "label": "Content" },
      { "type": "page", "id": "page", "label": "Content from page" } ] }
  ]
}
{% endschema %}
