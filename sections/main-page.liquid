<section class="collection-hero section--tight scheme-{{ section.settings.scheme }}">
  <div class="page-width"><h1 class="display">{{ page.title }}</h1></div>
</section>
{%- if page.content != blank -%}
  <section class="section">
    <div class="page-width rte" style="max-width: 820px">{{ page.content }}</div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": [ {"type": "select", "id": "scheme", "label": "Colour block", "default": "honey", "options": [{"value": "light", "label": "LM Light"}, {"value": "honey", "label": "LM Honey"}, {"value": "dark", "label": "LM Dark"}, {"value": "propolis", "label": "LM Propolis"}, {"value": "green", "label": "Green"}, {"value": "lime", "label": "Lime"}, {"value": "lavender", "label": "Lavender"}, {"value": "sky", "label": "Sky"}]} ]
}
{% endschema %}
