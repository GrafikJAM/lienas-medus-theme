{%- comment -%} Line items shared by the cart drawer and cart page. {%- endcomment -%}
{%- for item in cart.items -%}
  <div class="line-item" data-line-key="{{ item.key }}">
    <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
      {%- if item.image -%}
        {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
      {%- endif -%}
    </a>
    <div>
      <a class="line-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
      {%- unless item.product.has_only_default_variant -%}
        <div class="line-item__meta">{{ item.variant.title }}</div>
      {%- endunless -%}
      {%- for p in item.properties -%}
        {%- assign first_char = p.first | slice: 0 -%}
        {%- if p.last != blank and first_char != '_' -%}
          <div class="line-item__meta">{{ p.first }}: {{ p.last }}</div>
        {%- endif -%}
      {%- endfor -%}
      <div class="line-item__actions">
        <div class="qty">
          <button type="button" data-line-change="-1" aria-label="{{ 'accessibility.decrease' | t }}">−</button>
          <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'accessibility.quantity' | t }}">
          <button type="button" data-line-change="1" aria-label="{{ 'accessibility.increase' | t }}">+</button>
        </div>
        <button type="button" class="link-button" data-line-change="remove">{{ 'accessibility.remove' | t }}</button>
      </div>
    </div>
    <div class="price">{{ item.final_line_price | money }}</div>
  </div>
{%- endfor -%}
