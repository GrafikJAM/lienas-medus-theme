{%- comment -%}
  Brand tokens and fonts.
  Headings: Larken (EllenLuff), loaded from Shopify admin → Content → Files
  (licensed font, kept out of this public repo). Each weight tries, in order:
    1. the OTFs already in Files: EllenLuff_-_Larken_Regular / _Medium /
       _Medium_Italic / _Bold / _Bold_Italic .otf
    2. EllenLuff_-_Larken_Variable.ttf (covers every weight incl. ExtraBold)
  Body: Josefin Sans from the Shopify font library (theme setting).
{%- endcomment -%}
{%- liquid
  assign body_font = settings.type_body_font
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign heading_fallback = settings.type_heading_fallback
-%}
{%- if settings.use_larken -%}
  {{ 'EllenLuff_-_Larken_Bold.otf' | file_url | preload_tag: as: 'font', type: 'font/otf', crossorigin: 'anonymous' }}
{%- endif -%}
<style>
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ heading_fallback | font_face: font_display: 'swap' }}

  {%- if settings.use_larken -%}
  @font-face { font-family: 'Larken'; src: url('{{ 'EllenLuff_-_Larken_Regular.otf' | file_url }}') format('opentype'), url('{{ 'EllenLuff_-_Larken_Variable.ttf' | file_url }}') format('truetype'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Larken'; src: url('{{ 'EllenLuff_-_Larken_Medium.otf' | file_url }}') format('opentype'), url('{{ 'EllenLuff_-_Larken_Variable.ttf' | file_url }}') format('truetype'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Larken'; src: url('{{ 'EllenLuff_-_Larken_Bold.otf' | file_url }}') format('opentype'), url('{{ 'EllenLuff_-_Larken_Variable.ttf' | file_url }}') format('truetype'); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Larken'; src: url('{{ 'EllenLuff_-_Larken_Variable.ttf' | file_url }}') format('truetype'); font-weight: 800; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Larken'; src: url('{{ 'EllenLuff_-_Larken_Medium_Italic.otf' | file_url }}') format('opentype'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Larken'; src: url('{{ 'EllenLuff_-_Larken_Bold_Italic.otf' | file_url }}') format('opentype'); font-weight: 700; font-style: italic; font-display: swap; }
  {%- endif -%}

  :root {
    --c-dark: {{ settings.color_dark }};
    --c-light: {{ settings.color_light }};
    --c-honey: {{ settings.color_honey }};
    --c-propolis: {{ settings.color_propolis }};
    --c-green: {{ settings.color_green }};
    --c-lime: {{ settings.color_lime }};
    --c-lavender: {{ settings.color_lavender }};
    --c-sky: {{ settings.color_sky }};
    --c-white: #ffffff;

    --font-heading: {% if settings.use_larken %}'Larken', {% endif %}{{ heading_fallback.family }}, {{ heading_fallback.fallback_families }};
    --font-heading-weight: {{ settings.heading_weight }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-bold: {{ body_font_bold.weight }};

    --page-width: {{ settings.page_width }}px;
    --gutter: clamp(16px, 3vw, 40px);
    --rule: {{ settings.rule_width }}px solid var(--c-dark);
    --radius: {{ settings.button_radius }}px;
  }
</style>
