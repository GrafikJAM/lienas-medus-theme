<div class="drawer" data-cart-drawer aria-hidden="true">
  <button class="drawer__overlay" data-drawer-close tabindex="-1" aria-label="{{ 'general.close' | t }}"></button>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <div class="drawer__head">
      <h2 id="CartDrawerTitle">{{ 'cart.title' | t }}</h2>
      <button class="icon-button" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    {% section 'cart-drawer-content' %}
  </div>
</div>
