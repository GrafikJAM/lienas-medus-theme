{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
-%}
{%- if threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  -%}
  <div class="ship-bar">
    {%- if remaining > 0 -%}
      {%- assign remaining_money = remaining | money -%}
      {{ 'cart.free_shipping_left' | t: amount: remaining_money }}
    {%- else -%}
      {{ 'cart.free_shipping_reached' | t }}
    {%- endif -%}
    <div class="ship-bar__track" aria-hidden="true"><div class="ship-bar__fill" style="--progress: {{ progress }}%"></div></div>
  </div>
{%- endif -%}
