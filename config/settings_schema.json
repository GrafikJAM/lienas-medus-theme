[
  {
    "name": "theme_info",
    "theme_name": "Lienas Medus",
    "theme_version": "0.1.0",
    "theme_author": "Grafik JAM",
    "theme_documentation_url": "https://github.com/GrafikJAM/lienas-medus-theme",
    "theme_support_url": "https://github.com/GrafikJAM/lienas-medus-theme/issues"
  },
  {
    "name": "Brand colours",
    "settings": [
      { "type": "color", "id": "color_dark", "label": "LM Dark", "default": "#1D202B" },
      { "type": "color", "id": "color_light", "label": "LM Light", "default": "#FFF5E8" },
      { "type": "color", "id": "color_honey", "label": "LM Honey", "default": "#F2A838" },
      { "type": "color", "id": "color_propolis", "label": "LM Propolis", "default": "#9C3F23" },
      { "type": "color", "id": "color_green", "label": "Green", "default": "#31856C" },
      { "type": "color", "id": "color_lime", "label": "Lime", "default": "#D6E040" },
      { "type": "color", "id": "color_lavender", "label": "Lavender", "default": "#8D64AA" },
      { "type": "color", "id": "color_sky", "label": "Sky", "default": "#6CBAD6" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_larken",
        "label": "Use Larken for headings",
        "info": "Needs the six larken-*.woff2 files in Content → Files (see README). Untick to use the fallback font below.",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_heading_fallback",
        "label": "Heading fallback font",
        "default": "playfair_display_n7"
      },
      {
        "type": "range",
        "id": "heading_weight",
        "label": "Heading weight",
        "min": 400,
        "max": 800,
        "step": 100,
        "default": 700
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "josefin_sans_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Page width", "min": 1000, "max": 1600, "step": 50, "unit": "px", "default": 1400 },
      { "type": "range", "id": "rule_width", "label": "Divider line width", "min": 1, "max": 4, "step": 1, "unit": "px", "default": 2 },
      { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40 }
    ]
  },
  {
    "name": "Brand assets",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Optional. Defaults to the LM hexagon icon." },
      { "type": "image_picker", "id": "badge_image", "label": "Round brand badge", "info": "Optional. Leave empty to use the built-in vector badge." }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free delivery threshold (EUR)",
        "info": "Shows a progress bar in the cart. Set 0 to hide.",
        "default": 40
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" }
    ]
  }
]
